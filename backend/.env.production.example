# MauEkspor production environment
# Salin ke .env lalu isi nilai yang sebenarnya.
MAUEKSPOR_SECRET_KEY=change-me-to-a-long-random-string
MAUEKSPOR_DATABASE_URL=sqlite:///./data/mauekspor.db
MAUEKSPOR_CORS_ORIGINS=["https://app.mauekspor.com"]
MAUEKSPOR_ACCESS_TOKEN_EXPIRE_MINUTES=60
MAUEKSPOR_REFRESH_TOKEN_EXPIRE_DAYS=7
MAUEKSPOR_SEED_ADMIN_EMAIL=admin@mauekspor.example
MAUEKSPOR_SEED_ADMIN_PASSWORD=admin123
MAUEKSPOR_SEED_EXPORTER_EMAIL=rizal@kopigayo.example
MAUEKSPOR_SEED_EXPORTER_PASSWORD=rizal123

# Kode bootstrap untuk /auth/register-admin/. Wajib diset; tanpa ini endpoint selalu 403.
MAUEKSPOR_ADMIN_CODE=generate-a-long-random-string

# AI mode: "mock" (tanpa key, output contoh) atau "remote" (OpenAI-compatible)
MAUEKSPOR_AI_MODE=mock
MAUEKSPOR_AI_API_KEY=
MAUEKSPOR_AI_BASE_URL=https://api.openai.com/v1
MAUEKSPOR_AI_MODEL=gpt-4o-mini
