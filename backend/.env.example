# ── Database ──────────────────────────────────────────────────
# SQLite untuk dev lokal (default), PostgreSQL untuk production/Docker.
# MAUEKSPOR_DATABASE_URL=postgresql://mauekspor:mauekspor@db:5432/mauekspor
MAUEKSPOR_DATABASE_URL=sqlite:///./mauekspor.db

# ── Security ──────────────────────────────────────────────────
# Wajib di-override ke nilai acak yang kuat sebelum production.
MAUEKSPOR_SECRET_KEY=change-me-in-production

# ── AI (OpenAI-compatible endpoint) ──────────────────────────
# Mode: "mock" (jawaban canned untuk demo/test) atau "remote" (panggil
# endpoint nyata). Untuk memakai AI asli, set mode=remote + isi key/url/model.
MAUEKSPOR_AI_MODE=remote
MAUEKSPOR_AI_BASE_URL=http://localhost:20128/v1
MAUEKSPOR_AI_MODEL=qd/dmodel
MAUEKSPOR_AI_API_KEY=sk-dede08aea594e222-upk4p8-5bfa2c54

# Catatan: bila backend berjalan di dalam container Docker, localhost merujuk
# ke container itu sendiri. Gunakan host gateway, mis:
# MAUEKSPOR_AI_BASE_URL=http://host.docker.internal:20128/v1
# dan pastikan firewall mengizinkan container menjangkau port host.
