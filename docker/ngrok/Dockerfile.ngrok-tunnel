FROM ubuntu:22.04

RUN apt-get update && apt-get install -y curl dumb-init unzip jq wget && \
    rm -rf /var/lib/apt/lists/*

# Download ngrok from official releases
RUN cd /tmp && \
    wget https://bin.equinox.io/c/bNyj1mQVAI4/ngrok-stable-linux-amd64.tgz && \
    tar xzf ngrok-stable-linux-amd64.tgz && \
    mv ngrok /usr/local/bin/ && \
    chmod +x /usr/local/bin/ngrok && \
    rm ngrok-stable-linux-amd64.tgz

WORKDIR /app

COPY ./docker/ngrok/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# ENV defaults - override via docker-compose
ENV AUTHTOKEN=""
ENV PORT=8080
ENV SERVICE_NAME=nginx
ENV REGION=ap

HEALTHCHECK --interval=30s --timeout=10s CMD pgrep ngrok || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD []
