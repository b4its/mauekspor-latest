        <mxCell id="f2" value="&#xf132; 2. Kesiapan Ekspor&#xa;— Cek kepatuhan otomatis&#xa;— Karantina (PP 28/2024)&#xa;— ISPM-15 / HACCP&#xa;— SVLK / CITES&#xa;— Readiness score" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
