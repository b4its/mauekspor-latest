        <mxCell id="f8" value="&#xf53a; 8. Pembayaran&#xa;— Mark received&#xa;— Settled / Deposit Paid&#xa;— Send reminder&#xa;— Invoice billing" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
