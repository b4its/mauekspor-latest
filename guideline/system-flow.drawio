        <mxCell id="f6" value="&#xf016; 6. Dokumen Ekspor&#xa;— Packing list&#xa;— Commercial invoice&#xa;— Bill of lading&#xa;— Certificate of Origin&#xa;— Phytosanitary cert" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
