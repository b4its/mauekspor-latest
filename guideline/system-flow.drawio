        <mxCell id="f9" value="&#xf201; 9. Analytics &amp; Report&#xa;— Dashboard summary&#xa;— Export analytics&#xa;— Audit trail&#xa;— Scheduled reports" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
