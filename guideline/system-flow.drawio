        <mxCell id="f7" value="&#xf21c; 7. Pengiriman&#xa;— Booking forwarder&#xa;— Milestone tracking&#xa;— Exception handling&#xa;— Real-time status" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
