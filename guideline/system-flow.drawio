          <mxGeometry x="1670" y="900" width="380" height="50" as="geometry" />
        </mxCell>

        <!-- ===== SECURITY FLOW ===== -->
        <mxCell id="sec-group" value="Security &amp; Auth Flow" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="920" height="300" as="geometry" />
        </mxCell>
        <mxCell id="sec-1" value="1. Login&#xa;POST /auth/login/&#xa;→ access_token (1h)&#xa;→ refresh_token (7d)&#xa;→ cookies (HttpOnly)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sec-2" value="2. Request&#xa;Authorization: Bearer&#xa;OR cookie access_token&#xa;→ decode_token()&#xa;→ check type == 'access'" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="680" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sec-3" value="3. RBAC Check&#xa;can_read_module(role, module)&#xa;can_mutate_module(role, module)&#xa;Admin-only: users, admin, settings" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="680" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sec-4" value="4. Rate Limit&#xa;120 req/60s per IP&#xa;Login: 5 req/60s&#xa;Lockout: 10 fails → 429" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="680" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sec-5" value="5. Refresh&#xa;POST /auth/refresh/&#xa;X-Refresh-Token header&#xa;→ new access_token" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sec-6" value="6. Security Headers&#xa;CSP, X-Frame: DENY&#xa;X-Content-Type-Options&#xa;HSTS, Referrer-Policy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="780" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sec-7" value="7. Body Size Limit&#xa;Max 25MB per request&#xa;→ 413 if exceeded" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="780" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sec-8" value="8. File Upload&#xa;Extension allowlist&#xa;pdf/png/jpg/doc/xls/csv&#xa;→ 400 if not allowed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="780" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sec-9" value="9. Audit Trail&#xa;Every POST/PATCH/PUT/DELETE&#xa;→ audit_events table&#xa;actor, action, module, severity" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="880" width="280" height="50" as="geometry" />
        </mxCell>

        <!-- ===== EXPORT SUPPLY CHAIN FLOW ===== -->
        <mxCell id="flow-group" value="Rantai Pasok Ekspor Desa — Business Flow" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;" vertex="1" parent="1">
