        <mxCell id="f3" value="&#xf0c0; 3. Analisis Pasar&#xa;— Rekomendasi negara&#xa;— Tarif bea &amp; FTA&#xa;— Market intelligence&#xa;— Price range&#xa;— Competition level" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
