        <mxCell id="f5" value="&#xf093; 5. Costing &amp; Logistik&#xa;— EXW/FOB/CIF calculation&#xa;— Container capacity&#xa;— Forwarder recommendation&#xa;— AI optimization tips" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
