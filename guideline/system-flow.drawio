        <mxCell id="f1" value="&#xf3c5; 1. Standardisasi&#xa;Komoditas Desa&#xa;— Lengkapi profil produk&#xa;— HS code (AI enrich)&#xa;— SKU otomatis&#xa;— Sertifikasi" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
