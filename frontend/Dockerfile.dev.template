FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache curl && npm install -g pnpm@8.15.9

COPY package.json pnpm-lock.yaml* ./

RUN if [ -f pnpm-lock.yaml ]; then \
      pnpm install --frozen-lockfile; \
    else \
      pnpm install; \
    fi || pnpm install

COPY . .

CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "5188"]
