# Frontend DEV image - Vite dev server dengan hot reload
FROM node:22-alpine

WORKDIR /app

# Copy package files first for caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN corepack enable && pnpm install --frozen-lockfile

# Copy source (akan di-override oleh volume mount untuk hot reload)
COPY . .

# Vite dev server dengan HMR; HOST/PORT via env agar bind 0.0.0.0
ENV HOST=0.0.0.0 \
    PORT=5173

EXPOSE 5173

CMD ["pnpm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]

