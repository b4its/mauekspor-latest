# MauEkspor Local Development Stack
# Both frontend and backend use host network for easy LAN access
services:
  db:
    image: postgres:16-alpine
    container_name: mauekspor-dev-db
    ports:
      - "${DB_PORT:-5447}:5432"
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-mauekspor}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-mauekspor}
      POSTGRES_DB: ${POSTGRES_DB:-mauekspor}
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-mauekspor} -d ${POSTGRES_DB:-mauekspor}"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  backend:
    build:
      context: ./backend
      dockerfile: ./Dockerfile.dev
    container_name: mauekspor-dev-backend
    network_mode: host
    env_file:
      - .env.local
    environment:
      MAUEKSPOR_DATABASE_URL: postgresql://${POSTGRES_USER:-mauekspor}:${POSTGRES_PASSWORD:-mauekspor}@localhost:${DB_PORT:-5447}/${POSTGRES_DB:-mauekspor}
      MAUEKSPOR_AI_BASE_URL: ${MAUEKSPOR_AI_BASE_URL:-http://localhost:20128/v1}
      MAUEKSPOR_AI_MODEL: ${MAUEKSPOR_AI_MODEL:-hk/deepseek-4.1-flash}
      MAUEKSPOR_AI_API_KEY: ${MAUEKSPOR_AI_API_KEY:-your-ai-api-key-here}
      MAUEKSPOR_AI_MODE: ${MAUEKSPOR_AI_MODE:-remote}
      MAUEKSPOR_CORS_ORIGINS: ${MAUEKSPOR_CORS_ORIGINS}
      MAUEKSPOR_DISABLE_RATE_LIMIT: "1"
    volumes:
      - ./backend:/app:cached
      - uploads:/app/uploads
    healthcheck:
      test:
        - CMD-SHELL
        - curl -sf http://localhost:8016/api/v1/health || exit 1
      interval: 10s
      timeout: 8s
      retries: 3
      start_period: 30s
    restart: unless-stopped

  frontend:
    build:
      context: ./frontend
      dockerfile: ./Dockerfile.dev
    container_name: mauekspor-dev-frontend
    network_mode: host
    env_file:
      - .env.local
    environment:
      VITE_API_BASE_URL: /api/v1
      BACKEND_ORIGIN: http://localhost:8016
      NODE_ENV: development
      PORT: 5188
      HOST: 0.0.0.0
      # pnpm 10+ menjalankan "deps status check" otomatis saat `pnpm dev` dan
      # mencoba purge node_modules; di container tanpa TTY ini gagal. Nonaktifkan.
      CI: "true"
      COREPACK_ENABLE_DOWNLOAD_PROMPT: "0"
    volumes:
      - ./frontend:/app:cached
      # Isolasi artefak generated agar TIDAK bocor ke host lewat bind mount:
      # node_modules (paket container) & .svelte-kit (hasil `svelte-kit sync`)
      # harus tetap milik container. Tanpa ini, container menulis .svelte-kit
      # dengan versi kit yang berbeda dari host → error "Failed to load url …
      # shared-server.js … Does the file exist?".
      - /app/node_modules
      - /app/.svelte-kit
      - /app/node_modules/.vite
    healthcheck:
      test:
        - CMD-SHELL
        - curl -sf http://localhost:5188/ > /dev/null || exit 1
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 40s
    restart: unless-stopped
    depends_on:
      - backend

volumes:
  db-data:
  uploads:
